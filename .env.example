# Neon Postgres connection string. This project is low-traffic, so the same
# connection string is used for the app, the sync script, and migrations —
# use Neon's DIRECT (unpooled) connection string to avoid PgBouncer quirks
# with DDL, since there's no meaningful concurrency benefit to pooling here.
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/vrchat_map?sslmode=require"

# Optional: a second, empty Neon database used only by `prisma migrate dev`
# (local development) for schema-drift detection. Not needed for
# `migrate deploy` (production/CI) or for the app itself. If left unset,
# Prisma manages a scratch shadow database on the same server automatically.
SHADOW_DATABASE_URL=""

# Dedicated VRChat service account (never the developer's personal account)
VRCHAT_USERNAME=""
VRCHAT_PASSWORD=""

# Base32 TOTP secret captured when enabling 2FA (authenticator app) on the service account
VRCHAT_TOTP_SECRET=""

# Sent as the User-Agent header on every VRChat API call, per VRChat's own usage guidance
VRCHAT_USER_AGENT="VRChatStarfieldExplorer/1.0 (contact: you@example.com)"

# AES-256-GCM key for encrypting the persisted VRChat session cookie at rest.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=""
